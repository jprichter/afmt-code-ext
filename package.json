{
  "name": "afmt-code-ext",
  "displayName": "afmt Formatter",
  "description": "Apex formatter integration for afmt.",
  "version": "0.1.0",
  "publisher": "jprichter",
  "author": "Jake Richter <j.p.richter@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jprichter/afmt-code-ext.git"
  },
  "bugs": {
    "url": "https://github.com/jprichter/afmt-code-ext/issues"
  },
  "homepage": "https://github.com/jprichter/afmt-code-ext#readme",
  "keywords": [
    "apex",
    "formatter",
    "salesforce",
    "afmt"
  ],
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:apex"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "apex",
        "aliases": ["Apex", "apex"],
        "extensions": [".cls", ".trigger", ".apex", ".apexc"]
      }
    ],
    "configuration": {
      "title": "afmt",
      "properties": {
        "afmt.path": {
          "type": "string",
          "default": "",
          "description": "Path to the afmt binary. Leave empty to search PATH."
        },
        "afmt.configFile": {
          "type": "string",
          "default": "",
          "description": "Path to an afmt configuration file. Leave empty to discover the nearest .afmt.toml."
        },
        "afmt.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable afmt as the Apex formatter."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "npm run package && vsce package --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && node --test out/test/*.test.js",
    "prepare": "husky",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "lint:md": "markdownlint-cli2 README.md",
    "lint:md:fix": "markdownlint-cli2 --fix README.md"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "1.88.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.22.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  }
}
